# Copy to .env on the host machine. Secrets are NOT here - setup.sh writes 
# them to /var/lib/event-booking/secrets and compose bind-mounts the files.

### Quick Setup ###
#   sudo ./setup.sh
# Wait for "Admin account ... created" in the logs
#   docker compose logs -f app | grep -i 'admin'
# Save the password somewhere safe
#   sudo cat /var/lib/event-booking/secrets/bootstrap_admin_password
# Only once it is stored elsewhere, remove the file
#   sudo rm /var/lib/event-booking/secrets/bootstrap_admin_password

### Cleanup ###
# Disable containers and prune volumes
#   docker compose down -v
# Remove remaining secrets and logs
#   sudo rm -R /var/lib/event-booking /var/log/event-booking

BOOTSTRAP_ADMIN_USERNAME="master_admin"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"

POSTGRES_USER="event-booking"
POSTGRES_DB="event-booking"
POSTGRES_HOST="postgres" # Auto docker compose --network-alias
